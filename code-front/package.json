{
  "name": "calculadora_mwd",
  "version": "0.1.0",
  "main": "dist/mwdCalculator/browser/src-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "tauri-dev": "tauri dev",
    "tauri-build-lin-deb": "tauri build --bundles=deb",
    "tauri-build-lin-appImage": "tauri build --bundles=appimage",
    "tauri-build-win": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "tauri-build-android": "tauri android build",
    "electron-dev": "npm run electron-build-ts && npm run electron-copy-req-files && electron . --dev",
    "electron-build-exe-lin": "npm run electron-build-commons && npm run electron-build-exe -- --platform=linux",
    "electron-build-exe-win": "npm run electron-build-commons && npm run electron-build-exe -- --platform=win32",
    "electron-build-commons": "npm run build && npm run electron-copy-req-files && npm run electron-build-ts",
    "electron-build-exe": "npx electron-packager ./dist/mwdCalculator/browser/ --arch=x64 --out=dist --publish=never --overwrite",
    "electron-build-ts": "tsc -p ./src-electron/tsconfig.json --outDir ./dist/mwdCalculator/browser/src-electron/",
    "electron-copy-req-files": "mkdir -p ./dist/mwdCalculator/browser/ && cp ./src-electron/package.json ./dist/mwdCalculator/browser/",
    "test": "ng test",
    "test-e2e": "npx cypress open"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "export-to-csv": "^1.4.0",
    "ngx-papaparse": "^8.0.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/jasmine": " 5.1.15",
    "@types/jest": "^30.0.0",
    "@types/papaparse": "5.5.2",
    "copyfiles": "^2.4.1",
    "cypress": "14.5.4 ",
    "cypress-real-events": "1.15.0",
    "electron": "^36.9.5",
    "electron-packager": "^17.1.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.1.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}
